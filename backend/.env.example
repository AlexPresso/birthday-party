# Export these variables in the shell; Go does not automatically read .env files.
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
DATABASE_URL=postgresql://birthday:birthday-local-only@127.0.0.1:5432/birthday?sslmode=disable
# Session cookies are Secure exactly when PUBLIC_URL uses HTTPS. Set this only to
# override the derived value; false with an HTTPS PUBLIC_URL is rejected.
# COOKIE_SECURE=false
# Optional Web Push contact URI; HTTPS deployments default to PUBLIC_URL.
# VAPID_SUBJECT=mailto:you@example.com
# Signing keys are generated once and stored in PostgreSQL.
# Maximum upload size in MiB per file, whole numbers from 1 to 1024.
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=100
# Print a fresh administrator invitation at startup (Compose defaults to true).
PRINT_ADMIN_INVITATION=false

# Production: PUBLIC_URL=https://your-domain.example (session cookies then become Secure).
# Persist the complete DATA_DIR on a private disk, outside any public directory.
