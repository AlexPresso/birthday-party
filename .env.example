# Used by the local scripts and Docker Compose, for local development only.
# Production runs on Kubernetes with charts/birthday-party. Never commit the real .env.
PUBLIC_URL=http://localhost:3000
# Cookies are Secure automatically when PUBLIC_URL uses https. Leave this unset;
# the backend refuses COOKIE_SECURE=false with an https PUBLIC_URL.
# COOKIE_SECURE=true

# Web Push keys are generated once and stored in PostgreSQL.
# Phone notifications need HTTPS; localhost is allowed for desktop development.
# Optional VAPID contact URI. HTTPS deployments otherwise use PUBLIC_URL.
# VAPID_SUBJECT=mailto:you@example.com

# PostgreSQL is private to Compose; its records persist in the postgres-data volume.
# These defaults are for local use only. The Helm chart reads the production
# password from a Kubernetes Secret instead.
POSTGRES_DB=birthday
POSTGRES_USER=birthday
POSTGRES_PASSWORD=birthday-local-only
# Local Go scripts derive DATABASE_URL from these values and POSTGRES_PORT (5432).
# For a separately managed local database, override DATABASE_URL in the shell.
# DATABASE_URL=postgresql://birthday:birthday-local-only@127.0.0.1:5432/birthday?sslmode=disable

# Maximum size per uploaded file in MiB (1 MiB = 1024 * 1024 bytes).
# Whole numbers from 1 to 1024; defaults are 15 for images and 100 for videos.
# Imported once into PostgreSQL. Change them later in the administrator settings.
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=100

# Compose prints a fresh administrator invitation at each backend startup by default.
# Set false to disable; set true to enable it for local development as well.
# PRINT_ADMIN_INVITATION=true

# Initial login page customization (imported once into PostgreSQL).
# Later edits belong in the administrator settings and need no restart.
# Integer age from 1 to 150; missing or invalid values default to 30.
BIRTHDAY_AGE=30
# Copy follows the browser language: fr, en, de, it, es; English is the fallback.
# Priority: language-specific value, shared value, then translated default.
# Omit shared copy to keep translated defaults; an explicit empty value hides it.
# Shared copy applies unchanged to all languages without a language-specific value.
# INVITATION_TITLE="Alex's birthday"
# INVITATION_DESCRIPTION="The schedule, the photos and the guestbook are all here."
# Optional translations. Plain text, not HTML; titles otherwise follow BIRTHDAY_AGE.
# INVITATION_TITLE_FR="On fête mes 30 ans !"
# INVITATION_TITLE_EN="Come celebrate my 30th birthday!"
# INVITATION_TITLE_DE="Feiere meinen 30. Geburtstag mit!"
# INVITATION_TITLE_IT="Festeggiamo i miei 30 anni!"
# INVITATION_TITLE_ES="¡Celebremos mis 30 años!"
# INVITATION_DESCRIPTION_FR="Le programme, les photos et le livre d’or : tout est là."
# INVITATION_DESCRIPTION_EN="The schedule, the photos and the guestbook are all here."
# INVITATION_DESCRIPTION_DE="Das Programm, die Fotos und das Gästebuch: alles ist hier."
# INVITATION_DESCRIPTION_IT="Il programma, le foto e le dediche: è tutto qui."
# INVITATION_DESCRIPTION_ES="El programa, las fotos y las dedicatorias: todo está aquí."

# Optional local overrides (relative DATA_DIR is resolved from backend/).
# PORT=3000
# LISTEN_ADDR=127.0.0.1:8080
# API_INTERNAL_URL=http://127.0.0.1:8080
# DATA_DIR=./data
# GO_BIN=C:/path/to/go/bin/go.exe
