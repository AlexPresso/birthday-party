# Used by the local scripts and Docker Compose. Never commit the real .env.
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false

# Maximum size per uploaded file in MiB (1 MiB = 1024 * 1024 bytes).
# Whole numbers from 1 to 1024; defaults are 15 for images and 100 for videos.
# Applied to the API, interface and proxy by docker compose up, without rebuilding.
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=100

# Compose prints a fresh administrator invitation at each backend startup by default.
# Set false to disable; set true to enable it for local development as well.
# PRINT_ADMIN_INVITATION=true

# Login page customization (read at runtime).
# Keep shared settings in the repository-root .env; docker compose up loads it.
# Integer age from 1 to 150; missing or invalid values default to 30.
BIRTHDAY_AGE=30
# Copy follows the browser language: fr, en, de, it, es; English is the fallback.
# Priority: language-specific value, shared value, then translated default.
# Omit shared copy to keep translated defaults; an explicit empty value hides it.
# Shared copy applies unchanged to all languages without a language-specific value.
# INVITATION_TITLE="Alex's birthday"
# INVITATION_DESCRIPTION="See the photos and schedule, or leave a message."
# Optional translations. Plain text, not HTML; titles otherwise follow BIRTHDAY_AGE.
# INVITATION_TITLE_FR="On fête mes 30 ans !"
# INVITATION_TITLE_EN="Come celebrate my 30th birthday!"
# INVITATION_TITLE_DE="Feiere meinen 30. Geburtstag mit!"
# INVITATION_TITLE_IT="Festeggiamo i miei 30 anni!"
# INVITATION_TITLE_ES="¡Celebremos mis 30 años!"
# INVITATION_DESCRIPTION_FR="Retrouve les photos et le programme, ou laisse un message dans le livre d’or."
# INVITATION_DESCRIPTION_EN="See the photos and schedule, or leave a message in the guestbook."
# INVITATION_DESCRIPTION_DE="Hier findest du Fotos und das Programm. Im Gästebuch kannst du eine Nachricht hinterlassen."
# INVITATION_DESCRIPTION_IT="Qui trovi foto e programma. Puoi anche lasciare una dedica."
# INVITATION_DESCRIPTION_ES="Aquí tienes las fotos y el programa. También puedes dejar una dedicatoria."

# Optional local overrides (relative DATA_DIR is resolved from backend/).
# PORT=3000
# LISTEN_ADDR=127.0.0.1:8080
# API_INTERNAL_URL=http://127.0.0.1:8080
# DATA_DIR=./data
# GO_BIN=C:/path/to/go/bin/go.exe
