{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "publicUrl",
    "imageTag",
    "frontend",
    "backend",
    "postgresql",
    "externalDatabase",
    "ingress",
    "networkPolicy"
  ],
  "properties": {
    "publicUrl": { "type": "string", "pattern": "^https?://[^/?#@\\s]+$" },
    "imageTag": { "type": "string" },
    "nameOverride": { "$ref": "#/definitions/optionalName" },
    "fullnameOverride": { "$ref": "#/definitions/optionalName" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "resources": { "type": "object" }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "printAdminInvitation": { "type": "boolean" },
        "vapidSubject": { "type": "string" },
        "goMemoryLimit": {
          "type": "string",
          "pattern": "^([0-9]+(B|KiB|MiB|GiB|TiB))?$"
        },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "type": "object" }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "auth": {
          "type": "object",
          "properties": {
            "database": { "type": "string", "minLength": 1 },
            "username": { "type": "string", "minLength": 1 },
            "existingSecret": { "type": "string" },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "type": "object" }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "urlKey": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressFrom"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tolerations": { "type": "array", "items": { "type": "object" } }
  },
  "definitions": {
    "optionalName": {
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?)?$",
      "maxLength": 52
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["existingClaim", "size", "storageClass", "accessModes"],
      "properties": {
        "existingClaim": { "type": "string" },
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"]
          }
        }
      }
    }
  }
}
