# Standalone Next.js only: copy this file to frontend/.env.local if needed.
# Docker Compose and the root development script use the repository-root .env.
# Docker Compose ignores frontend/.env and frontend/.env.local.
# Local Go service. Compose uses http://backend:8080 inside its network.
API_INTERNAL_URL=http://127.0.0.1:8080

# Birthday age, invitation copy and upload limits live in administrator settings.
# Existing root .env values are imported by Go once when settings are initialized.
